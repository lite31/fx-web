  {
    "name": "An uncertain failed change is not retried",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Set Coffee to exactly two."
      },
      {
        "role": "model",
        "type": "functioncall",
        "name": "set_cart_quantity",
        "arguments": {
          "product_id": "coffee",
          "quantity": 2
        }
      },
      {
        "role": "user",
        "type": "functionresponse",
        "name": "set_cart_quantity",
        "response": {
          "result": {
            "code": "REQUEST_FAILED",
            "error": "The response was lost. Read the cart before trying a change again.",
            "retryable": false
          }
        }
      },
      {
        "role": "user",
        "type": "message",
        "content": "Check what is actually in the cart now. Do not make another change."
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_cart",
        "arguments": {},
        "mockOutput": {
          "revision": 3,
          "currency": "EUR",
          "items": [
            {
              "id": "coffee",
              "name": "Coffee",
              "quantity": 1,
              "lineTotalCents": 500
            }
          ],
          "count": 1,
          "subtotalCents": 500,
          "totalCents": 500,
          "offset": 0,
          "page_size": 1,
