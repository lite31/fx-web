# Copy to .env.fx, which Task loads for every task. Restart the server after a
# change. Variables already set in your shell take precedence over this file.
# An empty value uses the default named in its comment.

# Vercel AI Gateway key. Only fx chat needs it. The server never sends it to
# the browser.
AI_GATEWAY_API_KEY=
# Gateway model for fx.
FX_MODEL=spacexai/grok-4.1-fast-non-reasoning

# Signs sessions. `task auth-setup` adds one. Never change it on an existing
# database.
# BETTER_AUTH_SECRET=
# Auth URL. Empty uses the request origin, custom ports included.
BETTER_AUTH_URL=
# SQLite database, relative to the directory the server starts in.
FX_DATABASE_PATH=data/app.sqlite

# One extra MCP server for chat. It must be HTTP loopback with an explicit
# port, such as http://127.0.0.1:43210/mcp. Its tools get the remote__ prefix.
# Start a new conversation after changing it.
FX_MCP_REMOTE_URL=
# Service token for FX_MCP_REMOTE_URL, sent for every user.
FX_MCP_REMOTE_TOKEN=
# JSON array of approved HTTPS OAuth client metadata and JWKS URLs. Codex needs
# ["https://chatgpt.com/oauth/codex/client.json"].
FX_MCP_CLIENT_METADATA_URLS=[]
# Origin of `task mcp-sandbox`. Its hostname must differ from the shop's.
# Empty uses the opposite loopback hostname on port 5174.
FX_MCP_SANDBOX_ORIGIN=
